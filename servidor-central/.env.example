# Copia este archivo como .env y completa los valores. No lo subas al repositorio.

# Dominio público del servidor (su DNS debe apuntar a esta máquina). Caddy obtiene el certificado HTTPS.
DOMINIO=aprendo.miescuela.cl
# Nombre que verán las profesoras en el panel y en cada computador vinculado.
NOMBRE_SERVIDOR=Escuela Ejemplo · Aprendo a Leer

# Clave para cifrar los nombres de los estudiantes (64 caracteres hexadecimales). Genérala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# GUÁRDALA EN UN LUGAR SEGURO Y APARTE DE LOS RESPALDOS: sin ella no se pueden leer los nombres.
CENTRAL_DATA_KEY=
# Secreto de las sesiones del panel (al menos 32 caracteres aleatorios; mismo comando de arriba).
SESSION_SECRET=

# Primera cuenta de administrador: se crea al iniciar si no existe ninguna cuenta.
# Después de entrar por primera vez, borra ADMIN_CLAVE de este archivo.
ADMIN_USUARIO=admin
ADMIN_CLAVE=
ADMIN_NOMBRE=Administrador
ADMIN_APELLIDO=Escuela

# Detrás de Caddy (docker-compose) deja TRUST_PROXY=1 y COOKIE_SECURE=1.
TRUST_PROXY=1
COOKIE_SECURE=1

# Respaldos automáticos dentro de DATA_DIR/respaldos.
BACKUP_HOURS=24
BACKUP_KEEP=14
