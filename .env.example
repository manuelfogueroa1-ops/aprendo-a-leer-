# Copia este archivo como .env y reemplaza los valores.
# Genera cada clave con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Secreto de las sesiones (al menos 24 caracteres).
SESSION_SECRET=
# Clave de cifrado de los nombres (64 caracteres hexadecimales). Guárdala aparte: sin ella no se recuperan los nombres.
STUDENT_DATA_KEY=
# Opcionales:
# PORT=3000
# DB_FILE=backend/data/software-educativo.sqlite
